{
  "name": "Simulator Dev",
  "dockerComposeFile": [
    "../docker-compose.yml"
  ],
  "service": "frontend",
  "runServices": [
    "redis",
    "database",
    "frontend"
  ],
  "mounts": [
    "source=${localEnv:HOME}/.config/codex,target=/home/node/.codex,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.serena,target=/home/node/.serena,type=bind,consistency=cached"
  ],
  "workspaceFolder": "/workspace",
  "shutdownAction": "stopCompose",
  "overrideCommand": false,
  "remoteUser": "node",
  "forwardPorts": [
    8080,
    4000,
    6379
  ]
}
